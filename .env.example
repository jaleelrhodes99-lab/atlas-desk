# Environment Configuration

## Development
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

## Staging
# NODE_ENV=staging
# PORT=3000
# API_BASE_URL=https://atlas-desk-staging.vercel.app

## Production
# NODE_ENV=production
# PORT=3000
# API_BASE_URL=https://atlas-desk-gamma.vercel.app

## Feature Flags
ENABLE_LIVE_TRADING=false
ENABLE_PAPER_TRADING=true
ENABLE_BACKTEST=true
MAX_DAILY_LOSS_PERCENT=2

## AEGIS Security
AEGIS_ENABLED=true
AUDIT_LOG=true
KILL_SWITCH=true

## Third-party
MARKET_DATA_API=
BROKER_API_KEY=
